# DepthWizard SIH 2026 Environment Configuration
# ===============================================

# Network & Server
DEPTHWIZARD_HOST=127.0.0.1
DEPTHWIZARD_PORT=8000
DEPTHWIZARD_DEBUG=false

# Processing & Target Hardware (Pure CPU)
DEPTHWIZARD_TARGET_DEVICE=CPU
DEPTHWIZARD_ONNX_INTRA_OP_THREADS=2
DEPTHWIZARD_MODEL_INPUT_SIZE=518

# Model Checkpoint Path (Relative to project root or absolute)
DEPTHWIZARD_MODEL_PATH=backend/models/depth_anything_v2_vits_int8.onnx

# Storage Directories
DEPTHWIZARD_UPLOAD_DIR=backend/uploads
DEPTHWIZARD_OUTPUT_DIR=backend/outputs
DEPTHWIZARD_MAX_UPLOAD_SIZE_MB=250

# Cross-Origin Resource Sharing (JSON array format)
DEPTHWIZARD_CORS_ORIGINS=["*"]
